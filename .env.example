SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — only needed if Supabase is still signing tokens with the legacy
# HS256 shared secret. Newer projects use ES256 (asymmetric) and verify via
# the JWKS endpoint derived from SUPABASE_URL; in that case leave this blank.
# Dashboard → Project Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=

# Chat feature
OPENAI_API_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=your-project-ref
CHAT_MODEL=gpt-4o-mini

# Billing — Stripe
# Dashboard → Developers → API keys (use test keys in dev).
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:8000/api/billing/webhook` prints this.
STRIPE_WEBHOOK_SECRET=
# Recurring Price ID for the paid plan (Products → … → Pricing).
STRIPE_PRICE_ID_PAID=
# Used to build Stripe success/cancel redirect URLs.
APP_URL=http://localhost:5173
