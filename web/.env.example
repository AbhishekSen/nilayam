# Optional: override the API base URL.
# Leave empty for same-origin (dev uses Vite proxy /api → :8000; prod is single-origin).
VITE_API_BASE=

# Supabase Auth — anon key is designed to be public-safe (RLS protects data).
# Dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
